# Verrou d'accès. LAISSER VIDE pour que le site s'ouvre directement.
SITE_ACCESS_CODE=

# Vote partagé (optionnel). Sans ces variables, le vote fonctionne en mode
# local : chacun voit son propre choix, les totaux restent à zéro.
NEXT_PUBLIC_SUPABASE_URL=

# La clé publique de Supabase. Selon l'âge du projet, l'interface l'appelle
# « anon public » ou « publishable key ». Les DEUX noms de variable ci-dessous
# fonctionnent, il suffit d'en renseigner un.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
